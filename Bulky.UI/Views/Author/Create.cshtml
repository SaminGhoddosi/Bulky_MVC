@model Bulky.Models.ViewModels.AuthorViewModel

<div class="container">
    <h2>Create Author</h2>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Author.Name" class="form-label"></label>
            <input asp-for="Author.Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Author.BirthDate" class="form-label"></label>
            <input asp-for="Author.BirthDate" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Author.PublishHouseId" class="form-label"></label>
            <select asp-for="Author.PublishHouseId" asp-items="@Model.PublishingHouseList" class="form-select"></select>
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>